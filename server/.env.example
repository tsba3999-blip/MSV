# Скопировать в .env и заполнить. Файл .env в git не попадает.

# Подключение к базе. Пароль — тот, что задал deploy-msv.sh, он в /opt/msv/.env
DATABASE_URL=postgres://msv:ПАРОЛЬ@localhost:5432/msv

# Порт сервера. nginx проксирует на него.
PORT=3000

# Секрет для подписи сессий. Любая длинная случайная строка.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=замените-на-случайную-строку

# Папка с сайтом относительно server/
WEB_DIR=../web

# ВРЕМЕННО: пока не подключены смс и почта, пинкод печатается в лог,
# а код 7777 принимается для любого контакта. Перед запуском поставить 0.
DEMO_MODE=1
